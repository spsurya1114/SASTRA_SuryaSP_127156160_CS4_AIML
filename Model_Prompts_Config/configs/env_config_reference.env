# ==============================================================================
# SECURECODERAG ENVIRONMENT CONFIGURATION REFERENCE
# Case Study 4: Secure Code Debugging and Review Assistant
# ==============================================================================

# LLM Inference Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Vector Embeddings Configuration
OLLAMA_EMBED_MODEL=nomic-embed-text
VECTORSTORE_PATH=vectorstore
TOP_K=4

# Fallback / Cloud Provider (Optional, when local Ollama is disabled)
# GEMINI_API_KEY=your_gemini_api_key_here

# Security, JWT & Authentication
JWT_SECRET_KEY=e4f9b8c2d1a3e5f7a9b0c2d4e6f8a1b3c5d7e9f1a3b5c7d9e1f3a5b7c9d1e3f5
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database Persistence Paths
REVIEW_DATABASE_PATH=data/review.db
USERS_DATABASE_PATH=data/users.db

# Static Analysis Configuration
CPPCHECK_ENABLED=true
CPPCHECK_TIMEOUT_SECONDS=30
ENABLE_COMPILER_LOG_CORRELATION=true

# Logging & Operational Boundaries
LOG_LEVEL=INFO
ENVIRONMENT=production
